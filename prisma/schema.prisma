generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  name              String             @unique
  isAdmin           Boolean            @default(false)
  sessionVersion    Int                @default(0)
  totpSecret        String?
  totpEnabledAt     DateTime?
  totpLastStep      Int?
  publicListing     Boolean            @default(true)
  pushSubscriptions PushSubscription[]
  predictions       Prediction[]
  poolPredictions   PoolPrediction[]
  podiumPredictions PodiumPrediction[] 
  pointAdjustments  PointAdjustment[]
  matchReactions    MatchReaction[]
  matchComments     MatchComment[]
  createdAt         DateTime           @default(now())
}

model Match {
  id            Int          @id @default(autoincrement())
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player1       String
  player2       String
  seed1         Int?
  seed2         Int?
  score1        Int?
  score2        Int?
  isFinished    Boolean      @default(false)
  predictions   Prediction[]
  isLocked      Boolean      @default(false)
  startsAt      DateTime?
  strip         String?
  sourceUrl     String?
  sourceKey     String?
  sourceCheckedAt DateTime?
  round         String?
  manualUnlock  Boolean      @default(false)
  winner        Int?
  resultType    String?
  resultRegisteredAt DateTime?
  syncIssue String?
  pointsPending Boolean @default(false)
  manualResultConfirmed Boolean @default(false)
  progressionConfirmedAt DateTime?
  reactions     MatchReaction[]
  comments      MatchComment[]

  @@unique([competitionId, sourceKey])
}

model Prediction {
  id              Int      @id @default(autoincrement())
  userId          Int 
  matchId         Int 
  predictedScore1 Int
  predictedScore2 Int
  pointsEarned    Int      @default(0)
  bonusPoints     Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([userId, matchId])
  @@index([matchId])
}

model Tournament {
  archivedAt DateTime?
  completionNextCheckAt DateTime?
  ftlSourceUrl String? @unique
  id           Int           @id @default(autoincrement())
  name         String        
  isLocked     Boolean       @default(false) 
  competitions Competition[]
  createdAt    DateTime      @default(now())
}

model Competition {
  ftlEventId String? @unique
  id                Int                @id @default(autoincrement())
  tournamentId      Int
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name              String             
  sheetTabName      String?            
  isPodiumLocked    Boolean            @default(false)
  podiumManualUnlock Boolean           @default(false) 
  podiumFormat String @default("INDIVIDUAL")
  podiumRoster Json?
  identityReview Json?
  rosterSourceUrl String?
  rosterCheckedAt DateTime?
  officialPodium Json?
  resultsSourceUrl String?
  resultsVerifiedAt DateTime?
  podiumResolvedAt DateTime?
  podiumPredictions PodiumPrediction[]
  matches           Match[]
  matchRounds       MatchRound[]
  pools             Pool[]
  createdAt         DateTime           @default(now())
}

model PodiumPrediction {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  
  gold          String
  silver        String
  bronze1       String
  bronze2       String
  selectionIds Json?
  pointsEarned  Int          @default(0)

  @@unique([userId, competitionId])
  @@index([competitionId])
}

model PointAdjustment {
  requestKey String? @unique
  actorId Int?
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId  Int?     
  competitionId Int?     
  points        Int      
  reason        String?  
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([tournamentId])
  @@index([competitionId])
}

model Pool {
  id            Int          @id @default(autoincrement())
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  closesAt      DateTime
  lockMode      String       @default("FIRST_RESULT")
  sourceUrl     String?
  sourcePoolNumber Int?
  sourceCheckedAt DateTime?
  recomposedAt  DateTime?
  strip         String?
  startsAt      DateTime?
  rankingSystem String?
  rankingSourceUrl String?
  rankingAsOf DateTime?
  isLocked      Boolean      @default(false)
  isFinal       Boolean      @default(false)
  bouts         Json?
  createdAt     DateTime     @default(now())
  fencers       PoolFencer[]

  @@unique([competitionId, name])
}

model PoolFencer {
  id            Int              @id @default(autoincrement())
  poolId        Int
  pool          Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  name          String
  position      Int
  wins          Int?
  losses        Int?
  indicator     Int?
  firstResultAt DateTime?
  countryCode   String?
  ranking       Int?
  predictions   PoolPrediction[]

  @@unique([poolId, position])
}

model PoolPrediction {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fencerId      Int
  fencer        PoolFencer  @relation(fields: [fencerId], references: [id], onDelete: Cascade)
  wins          Int
  losses        Int
  indicator     Int
  createdAt     DateTime     @default(now())
  pointsEarned  Int          @default(0)
  updatedAt     DateTime     @updatedAt
  // Dernier enregistrement par le joueur (le recalcul des points ne le modifie pas).
  savedAt       DateTime?

  @@unique([userId, fencerId])
  @@index([fencerId])
}

model AuditLog {
  id Int @id @default(autoincrement())
  actorId Int
  action String
  targetType String
  targetId Int
  before Json?
  after Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([action, targetType, targetId])
}
model League {
  id Int @id @default(autoincrement())
  name String
  kind String @default("PRIVATE")
  ownerId Int
  // Tournoi de création (historique) : les groupes et clubs sont permanents, d'un tournoi à l'autre.
  tournamentId Int?
  startsAt DateTime
  code String @unique
  members LeagueMember[]
  createdAt DateTime @default(now())
  // Ancienne ligue du club fusionnée dans la ligue permanente.
  archivedAt DateTime?
  @@index([tournamentId])
}
model LeagueMember {
  id Int @id @default(autoincrement())
  leagueId Int
  league League @relation(fields:[leagueId],references:[id])
  userId Int
  joinedAt DateTime @default(now())
  // Départ : la ligne est gardée pour les classements des clubs des tournois déjà commencés.
  leftAt DateTime?
  @@unique([leagueId,userId])
  @@index([userId])
}
model Challenge {
  id Int @id @default(autoincrement())
  name String
  matchId Int @unique
  closesAt DateTime
  bonus Int @default(3)
  createdBy Int
  picks ChallengePick[]
  createdAt DateTime @default(now())
}
model ChallengePick {
  id Int @id @default(autoincrement())
  challengeId Int
  challenge Challenge @relation(fields:[challengeId],references:[id])
  userId Int
  winner Int
  updatedAt DateTime @updatedAt
  @@unique([challengeId,userId])
}

// Official manifest: counts exclude exemptions; previousRound is null only for the first round.
model MatchRound {
  competitionId Int
  competition Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round String
  previousRound String?
  expectedMatchCount Int
  sourceUrl String
  verifiedAt DateTime
  manualUnlockUntil DateTime?
  @@id([competitionId, round])
}

// A renewable claim shared by manual and automatic controls; survives restarts.
model FtlSyncState {
 competitionId Int @id
 leaseToken String?
 leaseUntil DateTime?
 lastStartedAt DateTime?
 lastFinishedAt DateTime?
 nextAutomaticAt DateTime? @default(now())
 failures Int @default(0)
 status String @default("PENDING")
 lastError String?
 @@index([nextAutomaticAt])
}

model PushSubscription {
 id String @id @default(uuid())
 userId Int
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 endpoint String @unique
 p256dh String
 auth String
 enabled Boolean @default(true)
 tournamentIds Int[]
 competitionIds Int[]
 preferences Json?
 preferencesSince DateTime @default(now())
 lastEventId Int @default(0)
 deliveries PushDelivery[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId])
}
model PushEvent {
 id Int @id @default(autoincrement())
 matchId Int @unique
 competitionId Int
 createdAt DateTime @default(now())
 @@index([createdAt])
}
model PushDelivery {
 id String @id @default(uuid())
 subscriptionId String
 subscription PushSubscription @relation(fields:[subscriptionId],references:[id],onDelete:Cascade)
 competitionId Int
 throughEventId Int
 kind String @default("MATCHES")
 round String @default("")
 matchIds Int[]
 status String @default("PENDING")
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 claimedAt DateTime?
 sentAt DateTime?
 createdAt DateTime @default(now())
 @@unique([subscriptionId,competitionId,throughEventId,kind,round], map:"PushDelivery_scope_event_kind_round_key")
 @@index([status,nextAttemptAt])
}
// Réglages de l'application (ex. club : nom et tireurs mis en avant).
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

// Réactions (un emoji par joueur et par match) et commentaires courts sur un match.
model MatchReaction {
  id        Int      @id @default(autoincrement())
  matchId   Int
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([matchId, userId])
}
model MatchComment {
  id        Int       @id @default(autoincrement())
  matchId   Int
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime  @default(now())
  hiddenAt  DateTime?
  hiddenBy  Int?

  @@index([matchId, createdAt])
}
