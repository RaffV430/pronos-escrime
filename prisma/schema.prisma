generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int                @id @default(autoincrement())
  email             String             @unique
  password          String
  name              String             @unique
  totalPoints       Int                @default(0)
  isAdmin           Boolean            @default(false)
  predictions       Prediction[]
  poolPredictions   PoolPrediction[]
  podiumPredictions PodiumPrediction[] 
  pointAdjustments  PointAdjustment[]
  createdAt         DateTime           @default(now())
}

model Match {
  id            Int          @id @default(autoincrement())
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  player1       String
  player2       String
  score1        Int?
  score2        Int?
  isFinished    Boolean      @default(false)
  predictions   Prediction[]
}

model Prediction {
  id              Int      @id @default(autoincrement())
  userId          Int 
  matchId         Int 
  predictedScore1 Int
  predictedScore2 Int
  pointsEarned    Int      @default(0)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([userId, matchId])
}

model Tournament {
  id           Int           @id @default(autoincrement())
  name         String        
  isLocked     Boolean       @default(false) 
  competitions Competition[]
  createdAt    DateTime      @default(now())
}

model Competition {
  id                Int                @id @default(autoincrement())
  tournamentId      Int
  tournament        Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name              String             
  sheetTabName      String?            
  isPodiumLocked    Boolean            @default(false) 
  podiumPredictions PodiumPrediction[]
  matches           Match[]
  pools             Pool[]
  createdAt         DateTime           @default(now())
}

model PodiumPrediction {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  
  gold          String
  silver        String
  bronze1       String
  bronze2       String
  pointsEarned  Int          @default(0)

  @@unique([userId, competitionId])
  @@index([competitionId])
}

model PointAdjustment {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentId  Int?     
  competitionId Int?     
  points        Int      
  reason        String?  
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([tournamentId])
  @@index([competitionId])
}

model Pool {
  id            Int          @id @default(autoincrement())
  competitionId Int
  competition   Competition  @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  name          String
  closesAt      DateTime
  isLocked      Boolean      @default(false)
  isFinal       Boolean      @default(false)
  createdAt     DateTime     @default(now())
  fencers       PoolFencer[]

  @@unique([competitionId, name])
}

model PoolFencer {
  id            Int              @id @default(autoincrement())
  poolId        Int
  pool          Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  name          String
  position      Int
  wins          Int?
  losses        Int?
  indicator     Int?
  predictions   PoolPrediction[]

  @@unique([poolId, position])
}

model PoolPrediction {
  id            Int         @id @default(autoincrement())
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fencerId      Int
  fencer        PoolFencer  @relation(fields: [fencerId], references: [id], onDelete: Cascade)
  wins          Int
  losses        Int
  indicator     Int
  createdAt     DateTime     @default(now())
  pointsEarned  Int          @default(0)
  updatedAt     DateTime     @updatedAt

  @@unique([userId, fencerId])
  @@index([fencerId])
}
