DATABASE_URL=postgresql://user:password@localhost:5432/pronos_escrime
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
PORT=5000

# Uniquement pour npm run db:seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Suivi des erreurs (facultatif) : DSN du projet Sentry
SENTRY_DSN=

# Mot de passe oublié (facultatif) : clé API Resend et expéditeur d'un domaine vérifié
RESEND_API_KEY=
MAIL_FROM=Pronos Escrime <noreply@votre-domaine.fr>
# Adresse publique de l'application (liens dans les e-mails)
APP_URL=https://pronos-escrime.vercel.app

# Mesures agrégées du SSE live (désactivées par défaut), sans identifiants ni données sportives.
LIVE_METRICS=false

# Mode veille des tâches de fond (hors compétition : passages groupés toutes les 15 min pour laisser dormir la base).
# BACKGROUND_IDLE=false rétablit l'ancien rythme (5 s / 30 s / 1 min / 5 min). BACKGROUND_IDLE_MS : période (≥ 6 min).
# BACKGROUND_IDLE=true
# BACKGROUND_IDLE_MS=900000
